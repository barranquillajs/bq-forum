---
import Container from "@components/Container/Container.astro";
import { SITE } from "@constants/general";
import { AuthButton } from "@components/AuthButton/AuthButton.tsx";
import { APP_URLS } from "@constants/urls";
import { USER_DATA } from "@constants/storage";

const userData = JSON.parse(Astro.cookies.get(USER_DATA)?.value ?? "{}")
---

<header class="fixed top-0 left-0 right-0 z-50 py-1 bg-stone-100/75 dark:bg-stone-900/25 backdrop-blur-sm saturate-200">
    <Container>
        <div class="flex items-center justify-between">
            <a href={APP_URLS.INDEX}>
                <div class="flex items-center gap-2">
                    <img src="/BAQJS.svg" alt="BarranquillaJs logo" class="w-10 rounded-full mb-1 bg-amber-300" />
                    <span class="text-2xl font-bold">{SITE.NAME}</span>
                </div>
            </a>
            <div class="flex items-center gap-4">
                <a class="btn btn-sm btn-info" href={APP_URLS.CREATE}>Crear +</a>
                <AuthButton client:only userData={userData} />
            </div>
        </div>
    </Container>
</header>
