---
import Container from "@components/Container/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { HOME } from "@constants/general";
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
    <Container>
        <main>
            <div class="my-10">
                <h1 class="text-4xl">Hola for</h1>
                <p>
                    Un logar donde puedes meter la informacion que quieras sobre
                    la ciudad o el meetup
                </p>
            </div>
        </main>
    </Container>
</PageLayout>
