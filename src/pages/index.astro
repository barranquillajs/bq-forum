---
import { getCollection } from "astro:content";

import Container from "@components/Container/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import type { ContentPost } from "@lib/types";
import { APP_URLS } from "@constants/urls";
import { HOME } from "@constants/general";


const posts = await getCollection("posts") as Array<ContentPost>;
const sortedPosts = posts.sort(
  (a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
    <Container>
        <main>
            <section class="my-14">
                <h1 class="text-4xl">Hola for</h1>
                <p>
                    Un lugar donde puedes crear conversaciones permanentes sobre la comunidad o la ciudad
                </p>
            </section>
            <section class="flex flex-col gap-4">
                {sortedPosts.map((post) => (
                    <a class="bg-base-100 rounded-lg cursor-pointer shadow-sm p-4" href={`${APP_URLS.POST}/${post.id}`}>
                        <h3 class="text-2xl font-bold mb-2">{post.data.title}</h3>
                        <div class="flex flex-row gap-2 items-center">
                            <div class="avatar">
                              <div class="w-10 rounded-full">
                                <img alt={`Usuario: ${post.data.name}`} src={post.data.avatarUrl} />
                              </div>
                            </div>
                            <span>{post.data.name}</span>
                        </div>
                    </a>
                ))}
            </section>
        </main>
    </Container>
</PageLayout>

<script>
  import { saveUserInfoIfAvaliable } from "@lib/auth";
  saveUserInfoIfAvaliable()
</script>
