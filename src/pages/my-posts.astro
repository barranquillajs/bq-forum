---
import { getCollection } from "astro:content";

import PostListSection from "@components/PostListSection/PostListSection.astro"
import PostPaginator from "@components/PostPaginator/PostPaginator.astro"
import Container from "@components/Container/Container.astro";
import { getPostUsableInformation } from "@lib/posts";
import PageLayout from "@layouts/PageLayout.astro";
import type { ContentPost, User } from "@lib/types";
import { HOME } from "@constants/general";
import { USER_DATA } from "@constants/storage";

const pageParam = Number(Astro.url.searchParams.get('page') ?? '1');
const userData = JSON.parse(Astro.cookies.get(USER_DATA)?.value ?? "{}") as User;

const posts = await getCollection("posts") as Array<ContentPost>;
const {paginatedPosts, totalPages, currentPage} = getPostUsableInformation(posts, pageParam, userData.id)
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <main>
      <section class="my-14">
        <h1 class="text-4xl">Tus posts creados</h1>
      </section>

      <PostListSection posts={paginatedPosts} />

      <PostPaginator totalPages={totalPages} currentPage={currentPage} />
    </main>
  </Container>
</PageLayout>
